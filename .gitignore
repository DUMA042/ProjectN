# ── Environment & Secrets ────────────────────────────────────────────────────
.env
*.env

# ── Excel source data (sensitive — never commit) ──────────────────────────────
nest/
!nest/.gitkeep

# ── Report Builder inbox (sensitive CSVs — never commit) ──────────────────────
report_inbox/

# ── Installer seed bundle (contains staff PII — never commit) ─────────────────
seed/

# ── Staff-data files (never commit new ones; already-tracked files unaffected)
*.xlsx
*.xls
*.docx
*.doc
*.csv

# ── Agent / planner scratch dirs (never commit) ───────────────────────────────
.opencode/
.zcode/

# ── Python artefacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.Python
build/
dist/
*.egg
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type checkers & linters ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Node / Tauri artefacts ─────────────────────────────────────────────────────
node_modules/
src-tauri/target/
dist-ssr/
*.local
*.log
