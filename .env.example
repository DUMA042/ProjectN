# ── Database ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/owl_db

# Optional: separate read-only role used by the AI query engine.
# Leave empty to fall back to the app session (read-only transaction).
# READER_DATABASE_URL=

# ── Data location ─────────────────────────────────────────────────────────────
# Root for uploads, report inbox, generated reports. Leave unset in development
# (defaults to the project folder). A packaged install should use:
#   FLOW_DATA_DIR=%APPDATA%\Flow
# FLOW_DATA_DIR=

# Per-directory overrides (optional). Defaults are derived from FLOW_DATA_DIR:
#   NEST_DIR           -> <FLOW_DATA_DIR>/nest           (raw Excel sources)
#   INBOX_DIR          -> <FLOW_DATA_DIR>/inbox          (upload landing zone)
#   REPORT_INBOX_DIR   -> <FLOW_DATA_DIR>/report_inbox   (sent-to-report files)
# Leave them unset unless you need a specific location — an explicit value
# here overrides the FLOW_DATA_DIR derivation.
# NEST_DIR=
# INBOX_DIR=
# REPORT_INBOX_DIR=

# Files above this size are streamed; above the hard cap they are rejected.
MAX_FILE_SIZE_MB=50

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8001

# Allowed browser/app origins, JSON array. Add the Tauri origin when packaging
# (e.g. http://tauri.localhost on Windows).
CORS_ORIGINS=["http://localhost:1420"]

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
# Production defaults to WARNING unless set explicitly.
LOG_LEVEL=INFO

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development

# ── AI (DeepSeek) ─────────────────────────────────────────────────────────────
# Paste your real key ONLY into your local .env (never commit it, never share
# it). Empty = AI features report "not configured" instead of failing.
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-flash
