# ── Database ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/owl_db

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Path to the directory containing Excel source files (relative to project root)
NEST_DIR=nest

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development

# ── AI (DeepSeek) ─────────────────────────────────────────────────────────────
# Paste your real key ONLY into your local .env (never commit it, never share
# it). Empty = AI features report "not configured" instead of failing.
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-flash
