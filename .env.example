# ── Database ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/owl_db

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Path to the directory containing Excel source files (relative to project root)
NEST_DIR=nest

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Runtime ───────────────────────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development
