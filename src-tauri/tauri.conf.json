{
  "$schema": "https://raw.githubusercontent.com/nicoencinas/tauri-settings-schema/HEAD/schema.json",
  "productName": "Flow",
  "version": "0.1.0",
  "identifier": "com.flow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flow",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
        "object-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Flow Team",
    "copyright": "\u00a9 2026 Flow",
    "category": "Business",
    "shortDescription": "Attendance and HR analytics for this PC.",
    "longDescription": "Flow turns staff card swipes, leave and training records into attendance analytics, reports and dashboards. Everything runs locally on this PC.",
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/postgres/": "postgres",
      "resources/runtime/": "",
      "resources/api/": "api",
      "resources/seed/": "seed"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
